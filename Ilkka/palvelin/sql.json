{
  "kukka": {
    "hae_kaikki": {
      "sql": [
        "select nimi,vari,hinta,maara from kukka"
      ]
    },
    "hae_nimella": {
      "sql": [
        "select nimi,vari,hinta,maara from kukka",
        "where nimi=?"
      ]
    },
    "hae_nimilista": {
      "sql": [
        "select nimi from kukka order by nimi asc"
      ]
    },
    "lisaa": {
      "sql": [
        "insert into kukka (nimi,vari,hinta,maara)",
        "values (?,?,?,?)"
      ],
      "parametrijarjestys": [
        "nimi",
        "vari",
        "hinta",
        "maara"
      ]
    },
    "paivita_kukka": {
      "sql": [
        "update kukka set vari=?,hinta=?,maara=?",
        "where nimi=?"
      ],
      "parametrijarjestys": [
        "vari",
        "hinta",
        "maara",
        "nimi"
      ]
    }
  },

  "viljelija": {
