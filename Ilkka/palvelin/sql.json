      ]
    },
    "hae_nimi_osoite_ytunnuksella": {
      "sql": [
        "select nimi,osoite from `viljelijä` where ytunnus=?"
      ]
    },
    "hae_nimi_numero_lista": {
      "sql": [
        "select nimi,viljelijannro from `viljelijä` order by nimi asc"
      ]
    },
    "lisaa": {
      "sql": [
        "insert into `viljelijä`",
        "(viljelijannro,ytunnus,nimi,osoite,yhteys_sukunimi,yhteys_etunimi,yhteys_puhelin,yhteys_email)",
        "values(?,?,?,?,?,?,?,?)"
      ],
      "parametrijarjestys": [
