  "varasto": {
    "hae_kaikki": {
      "sql": [
        "select numero,kukka.nimi as kukkanimi,",
        "`viljelijä`.viljelijannro,`viljelijä`.nimi as viljelijanimi,",
        "kukka.vari,kukka.hinta,kukka.maara,",
        "`viljelijän_kukat`.varastosaaldo,",
        "`viljelijän_kukat`.yksikköhinta",
        "from kukka",
        "inner join `viljelijän_kukat`",
        "on kukka.nimi=`viljelijän_kukat`.kukan_nimi",
        "inner join `viljelijä`",
        "on `viljelijä`.viljelijannro=`viljelijän_kukat`.viljelijannro",
        "order by `viljelijä`.nimi asc,kukka.nimi asc"
      ]
    },

    "lisaa": {
      "sql": [
        "insert into `viljelijän_kukat`",
        "(viljelijannro,kukan_nimi,varastosaaldo,yksikköhinta)",
        "values(?,?,?,?)"
      ],
      "parametrijarjestys": [
        "viljelijannro",
        "kukan_nimi",
        "varastosaaldo",
        "yksikkohinta"
      ]
    },

    "paivita_varasto": {
      "sql": [
        "update `viljelijän_kukat`",
        "set kukan_nimi=?,varastosaaldo=?,yksikköhinta=?",
        "where numero=?"
      ],
      "parametrijarjestys": [
        "kukan_nimi",
        "varastosaaldo",
        "yksikkohinta",
        "numero"
      ]
    },

    "paivita_varastosaldo": {
      "sql": [
        "update `viljelijän_kukat`",
        "set varastosaaldo=? where numero=?"
      ],
      "parametrijarjestys": [
        "varastosaaldo",
        "numero"
      ]
    },

    "perusavain": "numero"
  }
}
